<UserControl
    x:Class="Ryujinx.Ava.UI.Views.OpenPak.OpenPakSavesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    xmlns:appLibrary="clr-namespace:Ryujinx.Ava.Systems.AppLibrary"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    mc:Ignorable="d"
    x:DataType="viewModels:OpenPakViewModel">
    <Design.DataContext>
        <viewModels:OpenPakViewModel />
    </Design.DataContext>
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*">
        <!-- The same on every page: what this is on the left, fetch it again on the right. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0" Classes="page" Text="{ext:Locale Dialog_OpenPak_PageSaves}" />
            <Button Grid.Column="1" Name="RefreshButton" Content="{ext:Locale Dialog_OpenPak_Refresh}" MinWidth="90" IsEnabled="{Binding Ready}" />
        </Grid>

        <!-- Upload and download are about the title you pick, not about the row you clicked:
             the cloud may hold a save for a title, and the console may hold one, and they are
             two different questions. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,12">
            <ComboBox
                Grid.Column="0"
                Name="TitleBox"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding Titles}"
                SelectedItem="{Binding SelectedTitle}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="appLibrary:ApplicationData">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- The first upload of a title the cloud has never seen; every later one has a row. -->
            <Button Grid.Column="1" Name="UploadButton" Content="{ext:Locale Dialog_OpenPak_SavesUpload}" MinWidth="90" IsEnabled="{Binding Ready}" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Classes="sub" Text="{Binding UsageText}" IsVisible="{Binding SignedIn}" />
            <TextBlock Classes="sub" Text="{ext:Locale Dialog_OpenPak_SavesEmpty}" IsVisible="{Binding SavesEmpty}" />
            <TextBlock Classes="sub" Text="{ext:Locale Dialog_OpenPak_NeedSignIn}" IsVisible="{Binding SignedOut}" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Saves}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:OpenPakSaveModel">
                        <Border Classes="settings row">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <!-- The library's picture when the title is here, the catalogue's
                                     when it is not, and a box with a question mark when neither
                                     answered — a row with nothing in that corner reads as broken. -->
                                <Panel Grid.Column="0" Width="42" Height="42" VerticalAlignment="Top">
                                    <Border
                                        BorderBrush="{DynamicResource AppListHoverBackgroundColor}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <ui:FASymbolIcon
                                            Symbol="Help"
                                            FontSize="24"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                </Panel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="title" Text="{Binding TitleName}" TextTrimming="CharacterEllipsis" />
                                        <!-- A conflict is the one thing here somebody has to decide about,
                                             so it is said rather than silently resolved. -->
                                        <Border IsVisible="{Binding Conflict}" Background="#66B54141" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{ext:Locale Dialog_OpenPak_SavesConflict}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <!-- What it costs the allowance, then which upload the cloud
                                         would hand back and where that one came from. -->
                                    <TextBlock Classes="sub" Text="{Binding SizeText}" />
                                    <TextBlock Classes="sub" Text="{Binding Detail}" />
                                    <!-- Both sides, so the choice beside it is made on dates and not on faith. -->
                                    <TextBlock Classes="sub" Text="{Binding LocalDetail}" IsVisible="{Binding Installed}" />
                                    <TextBlock Classes="sub" Text="{ext:Locale Dialog_OpenPak_SavesNotInstalled}" IsVisible="{Binding NotInstalled}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <!-- Up and down need somewhere on this machine to read from or
                                         write to; deleting the cloud copy does not, so a title that
                                         is not installed here can still be cleared out. -->
                                    <Button Click="OnDownload" IsVisible="{Binding Installed}" Content="{ext:Locale Dialog_OpenPak_SavesDownload}" />
                                    <Button Click="OnUpload" IsVisible="{Binding Installed}" Content="{ext:Locale Dialog_OpenPak_SavesUpload}" />
                                    <Button Click="OnDelete" Content="{ext:Locale Dialog_OpenPak_SavesDelete}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
