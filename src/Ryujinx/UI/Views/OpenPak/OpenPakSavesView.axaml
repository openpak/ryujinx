<UserControl
    x:Class="Ryujinx.Ava.UI.Views.OpenPak.OpenPakSavesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    xmlns:appLibrary="clr-namespace:Ryujinx.Ava.Systems.AppLibrary"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    mc:Ignorable="d"
    x:DataType="viewModels:OpenPakViewModel">
    <Design.DataContext>
        <viewModels:OpenPakViewModel />
    </Design.DataContext>
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*">

        <!-- Upload and download are about the title you pick, not about the row you clicked:
             the cloud may hold a save for a title, and the console may hold one, and they are
             two different questions. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <ComboBox
                Name="TitleBox"
                Width="320"
                ItemsSource="{Binding Titles}"
                SelectedItem="{Binding SelectedTitle}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="appLibrary:ApplicationData">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- The first upload of a title the cloud has never seen; every later one has a row. -->
            <Button Name="UploadButton" Content="{ext:Locale Dialog_OpenPak_SavesUpload}" MinWidth="110" IsEnabled="{Binding Ready}" />
            <Button Name="RefreshButton" Content="{ext:Locale Dialog_OpenPak_Refresh}" MinWidth="110" IsEnabled="{Binding Ready}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding UsageText}" Opacity="0.8" Margin="4,0,0,12" IsVisible="{Binding SignedIn}" />

        <TextBlock
            Grid.Row="2"
            Text="{ext:Locale Dialog_OpenPak_SavesEmpty}"
            IsVisible="{Binding SavesEmpty}"
            Opacity="0.7"
            Margin="4,0,0,12" />

        <ListBox Grid.Row="3" ItemsSource="{Binding Saves}" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="viewModels:OpenPakSaveModel">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding TitleName}" FontWeight="SemiBold" />
                                <!-- A conflict is the one thing here somebody has to decide about,
                                     so it is said rather than silently resolved. -->
                                <Border
                                    IsVisible="{Binding Conflict}"
                                    Background="#66B54141"
                                    CornerRadius="3"
                                    Padding="6,1">
                                    <TextBlock Text="{ext:Locale Dialog_OpenPak_SavesConflict}" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <!-- Both sides, so the choice below is made on dates and not on faith. -->
                            <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="12" />
                            <TextBlock Text="{Binding LocalDetail}" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Click="OnDownload"
                            IsVisible="{Binding Installed}"
                            Content="{ext:Locale Dialog_OpenPak_SavesTakeCloud}" />
                        <Button
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            Click="OnUpload"
                            IsVisible="{Binding Installed}"
                            Content="{ext:Locale Dialog_OpenPak_SavesKeepLocal}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
