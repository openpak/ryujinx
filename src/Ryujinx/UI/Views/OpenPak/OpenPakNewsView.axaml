<UserControl
    x:Class="Ryujinx.Ava.UI.Views.OpenPak.OpenPakNewsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    xmlns:appLibrary="clr-namespace:Ryujinx.Ava.Systems.AppLibrary"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    mc:Ignorable="d"
    x:DataType="viewModels:OpenPakViewModel">
    <Design.DataContext>
        <viewModels:OpenPakViewModel />
    </Design.DataContext>
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*">
        <!-- The same on every page: what this is on the left, fetch it again on the right. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0" Classes="page" Text="{ext:Locale Dialog_OpenPak_PageNews}" />
            <Button Grid.Column="1" Name="RefreshButton" Content="{ext:Locale Dialog_OpenPak_Refresh}" MinWidth="90" IsEnabled="{Binding Ready}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,12">
            <ComboBox
                Grid.Column="0"
                Name="TitleBox"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding Titles}"
                SelectedItem="{Binding SelectedTitle}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="appLibrary:ApplicationData">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Name="SaveButton" Content="{ext:Locale Dialog_OpenPak_NewsSave}" MinWidth="90" IsEnabled="{Binding Ready}" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Classes="sub" Text="{Binding NewsValidFrom}" />
            <TextBlock Classes="sub" Text="{ext:Locale Dialog_OpenPak_NewsEmpty}" IsVisible="{Binding NewsEmpty}" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding NewsFiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:OpenPakNewsFileModel">
                        <Border Classes="settings row">
                            <StackPanel>
                                <TextBlock Classes="title" Text="{Binding Path}" FontFamily="{StaticResource JetBrainsMono}" />
                                <TextBlock Classes="sub" Text="{Binding Detail}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
