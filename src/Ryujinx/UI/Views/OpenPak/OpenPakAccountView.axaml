<UserControl
    x:Class="Ryujinx.Ava.UI.Views.OpenPak.OpenPakAccountView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    mc:Ignorable="d"
    x:DataType="viewModels:OpenPakViewModel">
    <Design.DataContext>
        <viewModels:OpenPakViewModel />
    </Design.DataContext>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- The same on every page: what this is on the left, fetch it again on the right. -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <TextBlock Grid.Column="0" Classes="page" Text="{ext:Locale Dialog_OpenPak_PageAccount}" />
                <Button Grid.Column="1" Name="RefreshButton" Content="{ext:Locale Dialog_OpenPak_Refresh}" MinWidth="90" IsEnabled="{Binding Ready}" />
            </Grid>

            <!-- Signed out: one thing to do, and it is the thing everything else needs. -->
            <StackPanel IsVisible="{Binding SignedOut}" Spacing="12" HorizontalAlignment="Center" Margin="0,40,0,0">
                <TextBlock
                    Text="{ext:Locale Dialog_OpenPak_NeedSignIn}"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center" />
                <Button
                    Name="SignInButton"
                    Classes="accent"
                    Content="{ext:Locale Dialog_OpenPak_SignIn}"
                    HorizontalAlignment="Center"
                    MinWidth="160" />
            </StackPanel>

            <StackPanel IsVisible="{Binding SignedIn}" Spacing="12">
                <!-- The identity card: who this is, how friends find them, and the way out. -->
                <Border Classes="settings card">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <!-- The picture is its own way to change it: a click, or its context menu. -->
                        <Button
                            Grid.Column="0"
                            Name="AvatarButton"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Top"
                            ToolTip.Tip="{ext:Locale Dialog_OpenPak_AccountChangePicture}"
                            IsEnabled="{Binding Ready}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="OnChangePicture" Header="{ext:Locale Dialog_OpenPak_AccountChangePicture}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Border
                                Width="56"
                                Height="56"
                                CornerRadius="28"
                                ClipToBounds="True"
                                Background="{DynamicResource ThemeControlBorderColor}">
                                <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                            </Border>
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <HyperlinkButton
                                    Name="ChangeNameButton"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding Ready}"
                                    Content="{ext:Locale Dialog_OpenPak_AccountChangeName}" />
                            </StackPanel>
                            <!-- The friend code as a pill somebody can select or copy. -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    CornerRadius="12"
                                    Padding="10,3"
                                    Background="{DynamicResource ThemeControlBorderColor}">
                                    <SelectableTextBlock Text="{Binding FriendCode}" FontFamily="{StaticResource JetBrainsMono}" TextWrapping="Wrap" />
                                </Border>
                                <Button Name="CopyCodeButton" Content="{ext:Locale Dialog_OpenPak_AccountCopy}" MinWidth="70" />
                            </StackPanel>
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Name="SignOutButton"
                            VerticalAlignment="Top"
                            Content="{ext:Locale Dialog_OpenPak_SettingsSignOut}"
                            IsEnabled="{Binding CanSignOut}"
                            ToolTip.Tip="{Binding SignOutTip}"
                            MinWidth="90" />
                    </Grid>
                </Border>

                <!-- Details, as label and value. -->
                <Border Classes="settings card">
                    <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="sub" Text="{ext:Locale Dialog_OpenPak_AccountFriendCode}" VerticalAlignment="Center" />
                        <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FriendCode}" VerticalAlignment="Center" FontFamily="{StaticResource JetBrainsMono}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="sub" Text="{Binding IdentityLabel}" VerticalAlignment="Center" />
                        <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SwitchPid}" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="sub" Text="{ext:Locale Dialog_OpenPak_AccountConsoles}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LinkedConsoles}" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <!-- Linking is automatic on sign-in; when it did not happen, one button
                             tries again. There is no second way to link. -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="sub" Text="{ext:Locale Dialog_OpenPak_AccountLink}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConsoleLink}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button
                            Grid.Row="3"
                            Grid.Column="2"
                            Name="TryAgainButton"
                            Content="{ext:Locale Dialog_OpenPak_AccountTryAgain}"
                            IsVisible="{Binding LinkFailed}"
                            IsEnabled="{Binding Ready}"
                            MinWidth="90" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
