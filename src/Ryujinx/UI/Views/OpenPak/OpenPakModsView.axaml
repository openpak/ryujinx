<UserControl
    x:Class="Ryujinx.Ava.UI.Views.OpenPak.OpenPakModsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    xmlns:appLibrary="clr-namespace:Ryujinx.Ava.Systems.AppLibrary"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    mc:Ignorable="d"
    x:DataType="viewModels:OpenPakViewModel">
    <Design.DataContext>
        <viewModels:OpenPakViewModel />
    </Design.DataContext>
    <Grid Margin="20" RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
            <TextBlock Text="{ext:Locale Dialog_OpenPak_ModsTitle}" VerticalAlignment="Center" />
            <ComboBox
                Name="TitleBox"
                Width="320"
                ItemsSource="{Binding Titles}"
                SelectedItem="{Binding SelectedTitle}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="appLibrary:ApplicationData">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Name="RefreshButton" Content="{ext:Locale Dialog_OpenPak_Refresh}" MinWidth="110" IsEnabled="{Binding Ready}" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Text="{ext:Locale Dialog_OpenPak_ModsEmpty}"
            IsVisible="{Binding ModsEmpty}"
            Opacity="0.7"
            Margin="4,0,0,12" />

        <ListBox Grid.Row="2" ItemsSource="{Binding Mods}" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="viewModels:OpenPakModModel">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Version}" Opacity="0.6" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" Opacity="0.8" FontSize="12" TextWrapping="Wrap" MaxWidth="520" />
                            <!-- Author and licence together: the catalogue refuses game data, and
                                 the licence is how somebody checks that for themselves. -->
                            <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Click="OnFavourite"
                            Content="{ext:Locale Dialog_OpenPak_ModsFavourite}" />
                        <Button
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            Classes="accent"
                            Click="OnInstall"
                            IsEnabled="{Binding NotInstalled}"
                            Content="{ext:Locale Dialog_OpenPak_ModsInstall}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
