<window:StyleableAppWindow
    x:Class="Ryujinx.Ava.UI.Windows.OpenPakWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:window="clr-namespace:Ryujinx.Ava.UI.Windows"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    xmlns:openPak="clr-namespace:Ryujinx.Ava.UI.Views.OpenPak"
    xmlns:helpers="clr-namespace:Ryujinx.Ava.UI.Helpers"
    Width="880"
    Height="600"
    MinWidth="760"
    MinHeight="480"
    WindowStartupLocation="CenterOwner"
    x:DataType="viewModels:OpenPakViewModel"
    mc:Ignorable="d"
    Focusable="True">
    <Design.DataContext>
        <viewModels:OpenPakViewModel />
    </Design.DataContext>
    <window:StyleableAppWindow.Styles>
        <!-- Every page is built from these and nothing else, so they cannot drift apart: a page
             title, a row's title and its secondary lines, a list row, and a card. -->
        <Style Selector="TextBlock.page">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.sub">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="16" />
        </Style>
    </window:StyleableAppWindow.Styles>
    <Grid RowDefinitions="*,Auto">
        <Grid Name="Pages" IsVisible="False">
            <openPak:OpenPakAccountView Name="AccountPage" />
            <openPak:OpenPakFriendsView Name="FriendsPage" />
            <openPak:OpenPakInvitationsView Name="InvitationsPage" />
            <openPak:OpenPakSavesView Name="SavesPage" />
            <openPak:OpenPakModsView Name="ModsPage" />
            <openPak:OpenPakNewsView Name="NewsPage" />
            <openPak:OpenPakStatusView Name="StatusPage" />
        </Grid>
        <ui:FANavigationView
            Grid.Row="0"
            Name="NavPanel"
            IsSettingsVisible="False"
            IsBackEnabled="False"
            Margin="10,0,10,0"
            OpenPaneLength="170">
            <ui:FANavigationView.MenuItems>
                <ui:FANavigationViewItem
                    IsSelected="True"
                    Content="{ext:Locale Dialog_OpenPak_PageAccount}"
                    Tag="AccountPage"
                    IconSource="Contact" />
                <!-- The count of friend requests waiting rides on this entry (UX spec §3.6). -->
                <ui:FANavigationViewItem
                    Name="FriendsNavItem"
                    Tag="FriendsPage"
                    IconSource="People">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{ext:Locale Dialog_OpenPak_PageFriends}" VerticalAlignment="Center" />
                        <Border
                            Grid.Column="1"
                            Name="RequestsBadge"
                            IsVisible="False"
                            Background="#D13438"
                            CornerRadius="9"
                            MinWidth="18"
                            Height="18"
                            Padding="5,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Name="RequestsBadgeText"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem
                    Content="{ext:Locale Dialog_OpenPak_PageInvitations}"
                    Tag="InvitationsPage"
                    IconSource="Mail" />
                <ui:FANavigationViewItem
                    Content="{ext:Locale Dialog_OpenPak_PageSaves}"
                    Tag="SavesPage"
                    IconSource="CloudBackup" />
                <ui:FANavigationViewItem
                    Content="{ext:Locale Dialog_OpenPak_PageMods}"
                    Tag="ModsPage">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FAFontIconSource
                            FontFamily="avares://Ryujinx/Assets/Fonts#Segoe Fluent Icons"
                            Glyph="{helpers:GlyphValueConverter Puzzle}" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem
                    Content="{ext:Locale Dialog_OpenPak_PageNews}"
                    Tag="NewsPage"
                    IconSource="Document" />
                <ui:FANavigationViewItem
                    Content="{ext:Locale Dialog_OpenPak_PageStatus}"
                    Tag="StatusPage"
                    IconSource="Wifi4" />
            </ui:FANavigationView.MenuItems>
            <ui:FANavigationView.Styles>
                <Style Selector="Grid#PlaceholderGrid">
                    <Setter Property="Height" Value="40" />
                </Style>
                <Style Selector="ui|FANavigationViewItem ui|FASymbolIcon">
                    <Setter Property="FlowDirection" Value="LeftToRight" />
                </Style>
            </ui:FANavigationView.Styles>
        </ui:FANavigationView>

        <!-- One status line for the whole window: every page's failures read the same, and a
             message from the friends page is still worth seeing after switching to saves. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="16,8">
            <ProgressBar
                Grid.Column="0"
                Width="90"
                Height="4"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                IsVisible="{Binding Busy}" />
            <TextBlock
                Grid.Column="1"
                Text="{Binding Message}"
                IsVisible="{Binding HasMessage}"
                TextWrapping="Wrap"
                VerticalAlignment="Center" />
            <!-- Close, not OK: the window saves nothing. -->
            <Button
                Grid.Column="2"
                Name="CloseButton"
                IsDefault="True"
                Content="{ext:Locale Dialog_OpenPak_CommonClose}"
                MinWidth="80"
                HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</window:StyleableAppWindow>
