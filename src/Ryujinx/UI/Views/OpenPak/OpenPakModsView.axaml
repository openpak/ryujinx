<UserControl
    x:Class="Ryujinx.Ava.UI.Views.OpenPak.OpenPakModsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    xmlns:appLibrary="clr-namespace:Ryujinx.Ava.Systems.AppLibrary"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    mc:Ignorable="d"
    x:DataType="viewModels:OpenPakViewModel">
    <Design.DataContext>
        <viewModels:OpenPakViewModel />
    </Design.DataContext>
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*">
        <!-- The same on every page: what this is on the left, fetch it again on the right. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0" Classes="page" Text="{ext:Locale Dialog_OpenPak_PageMods}" />
            <Button Grid.Column="1" Name="RefreshButton" Content="{ext:Locale Dialog_OpenPak_Refresh}" MinWidth="90" IsEnabled="{Binding Ready}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*" Margin="0,0,0,12">
            <ComboBox
                Grid.Column="0"
                Name="TitleBox"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding Titles}"
                SelectedItem="{Binding SelectedTitle}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="appLibrary:ApplicationData">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <TextBlock Grid.Row="2" Classes="sub" Text="{ext:Locale Dialog_OpenPak_ModsEmpty}" IsVisible="{Binding ModsEmpty}" />

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Mods}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:OpenPakModModel">
                        <Border Classes="settings row">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Classes="title" Text="{Binding Heading}" TextWrapping="Wrap" />
                                    <TextBlock Classes="sub" Text="{Binding Summary}" TextWrapping="Wrap" />
                                    <!-- Author and licence together: the catalogue refuses game data, and
                                         the licence is how somebody checks that for themselves. -->
                                    <TextBlock Classes="sub" Text="{Binding Detail}" />
                                </StackPanel>
                                <!-- The star shows the state; the tooltip says what it is. -->
                                <Button
                                    Grid.Column="1"
                                    Click="OnFavourite"
                                    VerticalAlignment="Center"
                                    Content="{Binding FavouriteGlyph}"
                                    ToolTip.Tip="{ext:Locale Dialog_OpenPak_ModsFavourite}" />
                                <!-- Nothing is installed under a running game: its mods are loaded. -->
                                <Button
                                    Grid.Column="2"
                                    Classes="accent"
                                    Click="OnInstall"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding CanChange}"
                                    ToolTip.ShowOnDisabled="True"
                                    ToolTip.Tip="{Binding ChangeTip}"
                                    Content="{Binding InstallText}" />
                                <Button
                                    Grid.Column="3"
                                    Click="OnUninstall"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding Installed}"
                                    IsEnabled="{Binding CanChange}"
                                    ToolTip.ShowOnDisabled="True"
                                    ToolTip.Tip="{Binding ChangeTip}"
                                    Content="{ext:Locale Dialog_OpenPak_ModsUninstall}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
