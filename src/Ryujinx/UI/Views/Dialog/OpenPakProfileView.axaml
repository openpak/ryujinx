<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    x:Class="Ryujinx.Ava.UI.Views.Dialog.OpenPakProfileView"
    Width="380">
    <StackPanel Spacing="16" HorizontalAlignment="Center">
        <Border
            Width="96" Height="96"
            CornerRadius="48"
            ClipToBounds="True"
            Background="{DynamicResource ThemeControlBorderColor}">
            <Image Name="Avatar" Width="96" Height="96" Stretch="UniformToFill" />
        </Border>
        <TextBlock Name="NameText" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
        <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock
                Text="{ext:Locale MenuBar_OpenPak_FriendCode}"
                HorizontalAlignment="Center"
                Opacity="0.7" />
            <TextBlock Name="FriendCodeText" FontSize="16" HorizontalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="ServerText" HorizontalAlignment="Center" Opacity="0.7" FontSize="12" />
    </StackPanel>
</UserControl>
