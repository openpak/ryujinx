<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    x:Class="Ryujinx.Ava.UI.Views.Dialog.OpenPakLinkView"
    Width="560">
    <StackPanel Spacing="16">
        <TextBlock
            Name="Instructions"
            TextWrapping="Wrap"
            Text="{ext:Locale MenuBar_OpenPak_LinkScan}" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
            <StackPanel Name="PhonePanel" Grid.Column="0" Spacing="8" HorizontalAlignment="Center">
                <Border Background="White" Padding="8" CornerRadius="4">
                    <Image Name="QrImage" Width="168" Height="168" />
                </Border>
                <!-- Hidden until a phone has signed in: a photograph of this screen must not be
                     worth anything on its own. -->
                <TextBlock
                    Name="CodeText"
                    FontSize="26"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    IsVisible="False" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{ext:Locale MenuBar_OpenPak_LinkOr}" FontWeight="Bold" />
                <TextBox Name="EmailBox" PlaceholderText="{ext:Locale MenuBar_OpenPak_LinkEmail}" />
                <TextBox Name="PasswordBox" PasswordChar="•" PlaceholderText="{ext:Locale MenuBar_OpenPak_LinkPassword}" />
                <Button
                    Name="SignInButton"
                    Content="{ext:Locale MenuBar_OpenPak_SignIn}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            </StackPanel>
        </Grid>
        <TextBlock Name="StatusText" TextWrapping="Wrap" IsVisible="False" />
        <Button
            Name="ApproveButton"
            Content="{ext:Locale MenuBar_OpenPak_LinkApprove}"
            IsVisible="False"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center" />
    </StackPanel>
</UserControl>
