<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    x:Class="Ryujinx.Ava.UI.Views.Dialog.OpenPakSignInView"
    Width="340">
    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="14">
        <!-- Why the dialog appeared on a first run; hidden every other time. -->
        <TextBlock Name="IntroText" TextWrapping="Wrap" Opacity="0.8" IsVisible="False" />
        <ui:FAInfoBar Name="StatusBar" IsClosable="False" Severity="Error" />
        <StackPanel>
            <TextBlock Classes="label" Text="{ext:Locale Dialog_OpenPak_SignInEmail}" />
            <TextBox Name="EmailBox" />
        </StackPanel>
        <StackPanel>
            <TextBlock Classes="label" Text="{ext:Locale Dialog_OpenPak_SignInPassword}" />
            <TextBox Name="PasswordBox" PasswordChar="•" Classes="revealPasswordButton" />
        </StackPanel>
        <!-- Named so the account's device list says which machine this is, rather than listing
             three identical entries a person cannot tell apart when revoking one. -->
        <StackPanel>
            <TextBlock Classes="label" Text="{ext:Locale Dialog_OpenPak_SignInDevice}" />
            <TextBox Name="DeviceBox" />
            <TextBlock Classes="hint" TextWrapping="Wrap" Text="{ext:Locale Dialog_OpenPak_SignInDeviceHint}" />
        </StackPanel>
        <HyperlinkButton
            Name="CreateButton"
            Padding="0"
            Content="{ext:Locale Dialog_OpenPak_SignInCreate}" />
        <!-- While the request runs: the fields stay where they are, and this says something is. -->
        <ProgressBar Name="BusyBar" IsIndeterminate="True" IsVisible="False" Height="4" />
    </StackPanel>
</UserControl>
