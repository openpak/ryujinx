<UserControl
    x:Class="Ryujinx.Ava.UI.Views.OpenPak.OpenPakFriendsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    mc:Ignorable="d"
    x:DataType="viewModels:OpenPakViewModel">
    <Design.DataContext>
        <viewModels:OpenPakViewModel />
    </Design.DataContext>
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*">
        <!-- The same on every page: what this is on the left, fetch it again on the right. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0" Classes="page" Text="{ext:Locale Dialog_OpenPak_PageFriends}" />
            <Button Grid.Column="1" Name="RefreshButton" Content="{ext:Locale Dialog_OpenPak_Refresh}" MinWidth="90" IsEnabled="{Binding Ready}" />
        </Grid>

        <!-- Add by friend code: the only way onto someone's list, so it is the first thing here. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,12" IsVisible="{Binding SignedIn}">
            <TextBox
                Grid.Column="0"
                Name="FriendCodeBox"
                Text="{Binding FriendCodeEntry}"
                PlaceholderText="{ext:Locale Dialog_OpenPak_FriendsAddPlaceholder}"
                IsEnabled="{Binding SignedIn}" />
            <Button
                Grid.Column="1"
                Name="AddButton"
                Classes="accent"
                Content="{ext:Locale Dialog_OpenPak_FriendsAdd}"
                MinWidth="90"
                IsEnabled="{Binding Ready}" />
        </Grid>

        <!-- Signed out: the one thing to do, centred, as on every page that needs an account. -->
        <StackPanel Grid.Row="3" IsVisible="{Binding SignedOut}" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
            <TextBlock Text="{ext:Locale Dialog_OpenPak_NeedSignIn}" TextWrapping="Wrap" HorizontalAlignment="Center" />
            <Button Classes="accent" Click="OnSignIn" Content="{ext:Locale Dialog_OpenPak_SignIn}" HorizontalAlignment="Center" MinWidth="160" />
        </StackPanel>

        <!-- One list, not two tabs: a request nobody can see behind a tab is a request nobody
             answers, so they sit on top of the friends and take no room when there are none. -->
        <ScrollViewer Grid.Row="3" IsVisible="{Binding SignedIn}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel IsVisible="{Binding !RequestsEmpty}" Margin="0,0,0,16">
                    <TextBlock Classes="h1" Text="{ext:Locale Dialog_OpenPak_FriendsRequests}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Requests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:OpenPakRequestModel">
                                <Border Classes="settings row">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Classes="title" Text="{Binding DisplayName}" />
                                            <TextBlock Classes="sub" Text="{Binding Status}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Classes="accent"
                                            Padding="8"
                                            MinWidth="0"
                                            MinHeight="0"
                                            VerticalAlignment="Center"
                                            Click="OnAccept"
                                            IsVisible="{Binding CanAccept}"
                                            ToolTip.Tip="{ext:Locale Dialog_OpenPak_FriendsAccept}">
                                            <ui:FASymbolIcon Symbol="Accept" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <!-- Declining someone else's request and withdrawing your own
                                             are the same call, so only the tooltip changes its word. -->
                                        <Button
                                            Grid.Column="2"
                                            Padding="8"
                                            MinWidth="0"
                                            MinHeight="0"
                                            VerticalAlignment="Center"
                                            Click="OnDecline"
                                            ToolTip.Tip="{Binding DeclineText}">
                                            <ui:FASymbolIcon Symbol="Dismiss" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Classes="h1" Text="{ext:Locale Dialog_OpenPak_FriendsList}" Margin="0,0,0,8" />
                <TextBlock Classes="sub" Text="{ext:Locale Dialog_OpenPak_FriendsEmpty}" IsVisible="{Binding FriendsEmpty}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Friends}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:OpenPakFriendModel">
                            <Border Classes="settings row">
                                <StackPanel>
                                    <!-- A click expands the row in place: the collapsed line is a
                                         scan, and the detail panel underneath is what somebody
                                         actually asked to see. -->
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" Cursor="Hand" Tapped="OnToggleExpand">
                                        <!-- Presence as a dot: the list is scanned, not read. -->
                                        <Panel Grid.Column="0" Width="34" Height="34">
                                            <Border CornerRadius="17" Background="{DynamicResource ThemeControlBorderColor}">
                                                <TextBlock
                                                    Text="{Binding Initial}"
                                                    FontWeight="SemiBold"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="0" />
                                            </Border>
                                            <!-- Over the initial, which stays visible while the picture
                                                 is on its way and for anyone whose fetch fails. -->
                                            <Border CornerRadius="17" ClipToBounds="True">
                                                <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                            </Border>
                                            <Ellipse
                                                Width="11"
                                                Height="11"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Stroke="{DynamicResource ThemeDarkColor}"
                                                StrokeThickness="2"
                                                Fill="{Binding PresenceBrush}" />
                                        </Panel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Classes="title" Text="{Binding DisplayName}" />
                                            <TextBlock Classes="sub" Text="{Binding Status}" />
                                        </StackPanel>
                                        <!-- Both are rare and asked about first, so each gets its
                                             own icon rather than a menu opened for nothing else. -->
                                        <Button
                                            Grid.Column="2"
                                            Padding="8"
                                            MinWidth="0"
                                            MinHeight="0"
                                            VerticalAlignment="Center"
                                            Click="OnRemove"
                                            ToolTip.Tip="{ext:Locale Dialog_OpenPak_FriendsRemove}">
                                            <ui:FASymbolIcon Symbol="Delete" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button
                                            Grid.Column="3"
                                            Padding="8"
                                            MinWidth="0"
                                            MinHeight="0"
                                            VerticalAlignment="Center"
                                            Click="OnBlock"
                                            ToolTip.Tip="{ext:Locale Dialog_OpenPak_FriendsBlock}">
                                            <ui:FASymbolIcon Symbol="BlockContact" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <!-- The one hint that there is more here: which way is
                                             whichever a click would do next. -->
                                        <ui:FASymbolIcon Grid.Column="4" Symbol="ChevronDown" Opacity="0.6" VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}" />
                                        <ui:FASymbolIcon Grid.Column="4" Symbol="ChevronUp" Opacity="0.6" VerticalAlignment="Center" IsVisible="{Binding IsExpanded}" />
                                    </Grid>

                                    <!-- The detail panel: the game's own picture and name, which
                                         console they are on, when their session began, and the
                                         friendship itself — nothing a scan of the list needs, and
                                         nothing more than a click asked for. -->
                                    <Grid
                                        IsVisible="{Binding IsExpanded}"
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10"
                                        Margin="46,10,0,0">
                                        <Panel Grid.Column="0" Width="48" Height="48" VerticalAlignment="Top" IsVisible="{Binding HasTitleName}">
                                            <Border
                                                BorderBrush="{DynamicResource AppListHoverBackgroundColor}"
                                                BorderThickness="1"
                                                CornerRadius="4" />
                                            <Image Source="{Binding GameIcon}" Stretch="UniformToFill" />
                                        </Panel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Classes="title" Text="{Binding TitleName}" TextWrapping="Wrap" IsVisible="{Binding HasTitleName}" />
                                            <TextBlock Classes="sub" Text="{Binding ConsoleText}" IsVisible="{Binding HasConsole}" />
                                            <TextBlock Classes="sub" Text="{Binding SessionSinceText}" IsVisible="{Binding HasSessionSince}" />
                                            <TextBlock Classes="sub" Text="{Binding FriendCodeText}" IsVisible="{Binding HasFriendCode}" />
                                            <TextBlock Classes="sub" Text="{Binding FriendsSinceText}" IsVisible="{Binding HasFriendsSince}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
